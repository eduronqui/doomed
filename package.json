{
  "name": "doomed",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Eduardo Ronqui",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:worker": "mkdir -p dist && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy --tag \"$(git rev-parse --short HEAD)$(git diff --quiet HEAD || echo -dirty)\"",
    "types:worker": "wrangler types",
    "sprites": "node scripts/build-sprites.mjs",
    "linter": "tsc --noEmit && tsc --noEmit -p worker && eslint .",
    "test": "vitest run"
  },
  "type": "module",
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.169.0"
  },
  "private": true,
  "engines": {
    "node": ">=26.13.1"
  }
}
